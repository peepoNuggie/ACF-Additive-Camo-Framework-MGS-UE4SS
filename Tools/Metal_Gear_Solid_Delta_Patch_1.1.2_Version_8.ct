aobscanmodule(AIHealth, MGSDelta-Win64-Shipping.exe, 39 81 38 01 00 00 0F 9E)
alloc(newmem, $80, AIHealth)

label(code)
label(EasyKills)
label(Undying)
label(OC)
label(return)

newmem:

code:
  // Mode: 0=vanilla, 1=easy kills, 2=undying
  cmp byte ptr [CustomAIHealthState], 1
  je EasyKills
  cmp byte ptr [CustomAIHealthState], 2
  je Undying
  jmp OC

EasyKills:
  mov dword ptr [rcx+138], 0
  cmp dword ptr [rcx+138], eax   // eax is 0 from original xor; set flags for setle
  jmp return

Undying:
  mov dword ptr [rcx+138], 3000
  cmp dword ptr [rcx+138], eax   // compare vs 0 to set flags
  jmp return

OC:
  // Original compare to drive setle al
  cmp dword ptr [rcx+138], eax
  jmp return

CustomAIHealthState:
  db 0

AIHealth:
  jmp newmem
  nop
return:
registersymbol(AIHealth CustomAIHealthState)

[DISABLE]

AIHealth:
  db 39 81 38 01 00 00

unregistersymbol(AIHealth CustomAIHealthState)
dealloc(newmem)

