    <CheatEntry>
      <ID>141</ID>
      <Description>"Inventory"</Description>
      <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
      <Color>8080FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : MGSDelta-Win64-Shipping.exe
  Version: 
  Date   : 2025-08-26
  Author : RMLSNK
}

[ENABLE]
aobscanmodule(Inventory,MGSDelta-Win64-Shipping.exe,0F BF 41 28 C3)
alloc(newmem,$40,Inventory)
label(return)
label(getInventory)
label(Lock)

newmem:
  cmp dword ptr [Lock], 0
  jne short OC
  cmp word ptr [rcx+28], 1
  jne short OC
  mov dword ptr [Lock], 1
  lea rax, [rcx-10]
  mov [getInventory], rax
OC:
  movsx eax, word ptr [rcx+28]
  ret
  jmp return

getInventory:
  dq 0

Lock:
  dd 0

Inventory:
  jmp newmem
return:
registersymbol(Inventory getInventory)

[DISABLE]
Inventory:
  db 0F BF 41 28 C3
unregistersymbol(Inventory getInventory)
dealloc(newmem)

