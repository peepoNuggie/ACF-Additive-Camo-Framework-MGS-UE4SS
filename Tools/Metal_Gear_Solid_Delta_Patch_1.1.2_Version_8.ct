aobscanmodule(InfiniteSuppressor,MGSDelta-Win64-Shipping.exe,66 89 41 24 79 06)
alloc(newmem,$64,InfiniteSuppressor)

label(code)
label(return)

newmem:

code:
//Stack
  push rax
  pushfq

//Function
  mov ax, 250           // set suppressor durability
  mov [rcx+24], ax      // write durability
  test ax, ax           // set flags for branch
  jns short @f          // jump if non-negative
  xor eax, eax
  mov [rcx+24], ax
@@:

//Restore
  popfq
  pop rax

  jmp return

// 12 bytes
InfiniteSuppressor:
  jmp newmem
  nop 7


return:
registersymbol(InfiniteSuppressor)

