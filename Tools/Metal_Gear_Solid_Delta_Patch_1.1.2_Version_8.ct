aobscanmodule(SleepState,MGSDelta-Win64-Shipping.exe,8B 97 48 01 00 00 83 FA)
alloc(newmem,$100, SleepState)

label(code)
label(OC)
label(InstantTranq)
label(SleepAll)
label(AwakeAll)
label(return)

newmem:

code:
  // Mode: 0=vanilla, 1=instant, 2=sleep all, 3=awake all
  cmp byte ptr [CustomSleepState],1
  je InstantTranq
  cmp byte ptr [CustomSleepState],2
  je SleepAll
  cmp byte ptr [CustomSleepState],3
  je AwakeAll
  jmp OC

InstantTranq:
  mov edx, dword ptr [rdi+148]
  test edx, edx
  jle OC
  mov dword ptr [rdi+148], 1
  jmp OC

SleepAll:
  cmp dword ptr [rdi+148], 1
  je AwakeAll
  mov dword ptr [rdi+150], 14
  jmp OC

AwakeAll:
  mov edx, dword ptr [rdi+14C]
  mov dword ptr [rdi+148], edx
  jmp OC

OC:
  mov edx, dword ptr [rdi+148]
  jmp return

CustomSleepState:
  db 0

SleepState:
  jmp newmem
  nop
return:
registersymbol(SleepState CustomSleepState)

[DISABLE]

SleepState:
  db 8B 97 48 01 00 00

unregistersymbol(SleepState CustomSleepState)
dealloc(newmem)

